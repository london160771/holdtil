# Holdtil Scout (Phase 4). Its own wallet key, set by the owner by hand. Never commit it, never paste it in chat.
# Use a NEW wallet just for Scout. It only ever holds a few dollars of USDC.
SCOUT_PRIVATE_KEY=
# Same database as the server (Scout writes its runs to the scoutRuns collection).
MONGODB_URI=
# dry (default): reads the price only. live: pays x402stock.xyz for real.
SCOUT_MODE=
# Daily budget in USDC base units (300000 = $0.30). Each call costs about $0.03.
SCOUT_DAILY_MAX_USDC=
# Minutes between runs with `npm run scout:loop` (min 5, default 60).
SCOUT_INTERVAL_MIN=
