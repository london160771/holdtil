# Server env (names only; set real values by hand — never commit them).
# Dev values: Claude Code cloud environment. Prod values: Render → Environment. See PROJECT_STATE §11.
PORT=3001
BASE_RPC_URL=https://mainnet.base.org
SESSION_SECRET=
TICK_SECRET=
# Coinbase Developer Platform (spender smart account). Separate dev and prod keys.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Needed from Phase 2 (Render only; tests use in-memory MongoDB).
MONGODB_URI=
# The web app origin (same origin as the API via the Vercel rewrite). Sign-in checks this. Local: http://localhost:5173
APP_ORIGIN=http://localhost:5173
# Holdtil spender smart account (public address, not a secret). Must match the CDP account.
SPENDER_ADDRESS=0xb7F3c5F916359B303d3ecEbB39f47969444fd15B
# Refill executor. Leave unset (= dry: checks + simulation only, nothing sent). Set to live ONLY when the owner approves real refills.
EXECUTOR_MODE=
# Live rollout (step 4): only these comma-separated account addresses get real refills in live mode; everyone else stays dry.
LIVE_USER_ADDRESSES=
# Max USDC per real refill while rolling out, in base units (1000000 = $1). Default $1.
LIVE_MAX_REFILL_USDC=
